{
	"name": "@melodicdev/cli",
	"version": "4.1.1",
	"description": "Scaffolding and code generation for Melodic apps and monorepos.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MelodicDevelopment/melodic.git"
	},
	"bugs": {
		"url": "https://github.com/MelodicDevelopment/melodic/issues"
	},
	"homepage": "https://github.com/MelodicDevelopment/melodic#readme",
	"keywords": [
		"cli",
		"scaffold",
		"generator",
		"web-components",
		"melodic"
	],
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"bin": {
		"melodic": "./dist/index.js"
	},
	"files": [
		"dist",
		"templates",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.json",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"typescript": "~5.9.3",
		"vitest": "^3.2.4"
	}
}
